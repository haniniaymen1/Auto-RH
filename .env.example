# PaieSage — exemple de configuration
# Copier ce fichier vers « .env » puis adapter les valeurs.
# ⚠ NE JAMAIS COMMITTER le fichier .env réel (ignoré par .git) — permissions 600.

# ============================================================
# PORTS — SOURCE UNIQUE DE VÉRITÉ (v0.2.209)
# ============================================================
# Modifiez ces lignes puis redémarrez (gestion.sh / GESTION.bat redemarrer) :
# TOUS les lanceurs et le moteur silencieux lisent ces valeurs — aucun port
# n'est codé en dur dans les scripts (défauts 4000/4001 si le .env est absent).
# La disponibilité est vérifiée avant chaque lancement
# (node scripts/verifier-ports.js) : conflit = message + arrêt propre.
PORT=4000
PORTAL_PORT=4001
# Priorité avancée (inutile en usage normal) : PAIESAGE_PORT_ADMIN écrase PORT,
# PAIESAGE_PORT_PORTAIL écrase PORTAL_PORT (compatibilité historique conservée).

# ============================================================
# SUPERADMINISTRATEUR — CRÉATION AUTOMATIQUE (v0.2.209)
# ============================================================
# À la PREMIÈRE installation (base vierge), le compte superadministrateur est
# créé automatiquement au démarrage. Idempotent : rien n'est créé si un compte
# SUPERADMIN actif existe déjà (protection anti-doublon).
#   SUPERADMIN_AUTO=0     → désactive la création automatique ;
#   SUPERADMIN_EMAIL      → identifiant de connexion choisi par vous ;
#   SUPERADMIN_PASSWORD   → mot de passe (8+ caractères, majuscule, minuscule,
#                           chiffre, symbole). NON DÉFINI = mot de passe
#                           aléatoire généré, affiché une seule fois et
#                           consigné dans logs/compte-superadmin-initial.txt
#                           (à communiquer puis supprimer).
SUPERADMIN_AUTO=1
# SUPERADMIN_EMAIL=admin@auto-rh.local
# SUPERADMIN_PASSWORD=

# Base de données SQLite (chemin absolu recommandé)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Secret de signature des sessions (HMAC) — OBLIGATOIRE en production :
#   openssl rand -hex 48
# Sans lui : secret aléatoire à chaque démarrage (sessions invalidées au
# redémarrage, administration comme portail).
# AUTH_SECRET=...

# Clé de chiffrement DÉDIÉE (Task 208) — chiffre les fiches importées
# (storage/), les copies de tampons/certificats ET les champs sensibles de la
# base (emails, CIN, mots de passe SMTP/certificats). OBLIGATOIRE en prod :
#   openssl rand -base64 48
# ⚠ NE PAS PERDRE : sans cette clé, les données chiffrées sont
#   mathématiquement irrécupérables. Rotation possible avec
#   scripts/chiffrer-storage.js + scripts/chiffrer-base.js (voir README).
# PAIESAGE_STORAGE_KEY=...

# (Option) Forcer le flag « Secure » des cookies de session même sans
# proxy HTTPS détecté (x-forwarded-proto) — 1 = forcé.
# PAIESAGE_FORCE_SECURE_COOKIES=1

# (Option) DÉCONSEILLÉ : désactive le chiffrement des NOUVEAUX imports
# (les fichiers déjà chiffrés restent déchiffrés à la lecture).
# Laisser NON DÉFINI en production (valeur autre que 1 = actif).
# PAIESAGE_STORAGE_DISABLE=0

# Ports par défaut (le lanceur scripts/service-paiesage.js les applique)
# PAIESAGE_PORT_ADMIN=4000
# PAIESAGE_PORT_PORTAIL=4001
# PORTAL_PORT=4001

# (Option) Intervalle du poller IMAP en secondes (réception des réponses
# RH/manager du portail employé :4001) — minimum 15, défaut 120.
# (v0.2.161) Déployé à 15 s : valeur posée ici ET injectée par
# scripts/redemarrer-services-4000-4001.js (prioritaire sur .env).
# Nécessite la réception IMAP activée dans l'administration
# (Paramètres → Mail → imapActif).
PAIESAGE_IMAP_INTERVALLE=15

