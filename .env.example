# AutoRH — exemple de configuration
# Copier ce fichier vers « .env » puis adapter les valeurs.
# ⚠ NE JAMAIS COMMITTER le fichier .env réel (ignoré par .git) — permissions 600.

# Base de données SQLite (chemin absolu recommandé)
DATABASE_URL=file:/home/z/my-project/db/custom.db

# Secret de signature des sessions (HMAC) — OBLIGATOIRE en production :
#   openssl rand -hex 48
# Sans lui : secret aléatoire à chaque démarrage (sessions invalidées au
# redémarrage, administration comme portail).
# AUTH_SECRET=...

# Clé de chiffrement DÉDIÉE (Task 208) — chiffre les fiches importées
# (storage/), les copies de tampons/certificats ET les champs sensibles de la
# base (emails, CIN, mots de passe SMTP/certificats). OBLIGATOIRE en prod :
#   openssl rand -base64 48
# ⚠ NE PAS PERDRE : sans cette clé, les données chiffrées sont
#   mathématiquement irrécupérables. Rotation possible avec
#   scripts/chiffrer-storage.js + scripts/chiffrer-base.js (voir README).
# AUTORH_STORAGE_KEY=...

# (Option) Forcer le flag « Secure » des cookies de session même sans
# proxy HTTPS détecté (x-forwarded-proto) — 1 = forcé.
# AUTORH_FORCE_SECURE_COOKIES=1

# (Option) DÉCONSEILLÉ : désactive le chiffrement des NOUVEAUX imports
# (les fichiers déjà chiffrés restent déchiffrés à la lecture).
# Laisser NON DÉFINI en production (valeur autre que 1 = actif).
# AUTORH_STORAGE_DISABLE=0

# Ports par défaut (le lanceur scripts/auto-rh.js les applique)
# AUTORH_PORT_ADMIN=4000
# AUTORH_PORT_PORTAIL=4001
# PORTAL_PORT=4001

# (Option) Intervalle du poller IMAP en secondes (réception des réponses
# RH/manager du portail employé :4001) — minimum 15, défaut 120.
# (v0.2.161) Déployé à 15 s : valeur posée ici ET injectée par
# scripts/redemarrer-services-4000-4001.js (prioritaire sur .env).
# Nécessite la réception IMAP activée dans l'administration
# (Paramètres → Mail → imapActif).
AUTORH_IMAP_INTERVALLE=15


